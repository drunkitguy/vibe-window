+                error = "decoded zstd asset too short";
+                return LocateStatus::Error;
+            }
+            RememberExpanded(out.chain, out.file);
+        }
         if (std::memcmp(out.magic.data(), "FRES", 4) == 0) {
             std::vector<u8> container;
             if (!ReadAll(out, container, error)) {
@@ -789,6 +819,47 @@ bool NxAssetState::ReadAll(const Located& at, std::vector<u8>& bytes, std::strin
     return true;
 }
 
+std::shared_ptr<const Zstd::Dicts> NxAssetState::ZstdDicts(const std::string& chain,
+                                                           const Roots& roots) {
+    {
+        std::scoped_lock lock{io_mutex};
+        if (const auto it = zstd_dicts.find(chain); it != zstd_dicts.end()) {
+            return it->second;
+        }
+    }
+    // shortcut: two threads may load the same file at once (the first stored wins), fine while
+    // ZsDic is small; add a load lock if it ever shows up in a profile.
+    auto dicts = std::make_shared<Zstd::Dicts>();
+    Located at;
+    std::string error;
+    std::vector<u8> bytes;
+    NX::SarcIndex index;
+    bool ok = Locate(chain, roots, at, error) == LocateStatus::Ok && ReadAll(at, bytes, error) &&
+              NX::ParseSarc(NX::SpanReader(bytes), bytes.size(), index, error);
+    size_t added = 0;
+    for (auto it = index.by_name.begin(); ok && it != index.by_name.end(); ++it) {
+        if (!it->first.ends_with(".zsdic")) {
+            continue;
+        }
+        // ParseSarc keeps every member inside the archive's size.
+        if (!dicts->Add(std::span(bytes).subspan(it->second.offset, it->second.size))) {
+            ok = false;
+            error = "bad zstd dictionary '" + it->first + "'";
+        }
+        ++added;
+    }
+    if (ok && added == 0) {
+        ok = false;
+        error = "no .zsdic member";
+    }
+    std::scoped_lock lock{io_mutex};
+    const auto [it, inserted] = zstd_dicts.try_emplace(chain, ok ? std::move(dicts) : nullptr);
+    if (!ok && inserted) {
+        LOG_WARNING(Core, "DSMod: zstd dictionaries '{}': {}", chain, error);
+    }
+    return it->second;
+}
