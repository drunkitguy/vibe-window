diff --git a/src/core/mods/mod_zstd.cpp b/src/core/mods/mod_zstd.cpp
new file mode 100644
index 0000000..5132c53
--- /dev/null
+++ b/src/core/mods/mod_zstd.cpp
@@ -0,0 +1,79 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden DSMod fork
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <memory>
+
+#include <zstd.h>
+
+#include "core/mods/mod_zstd.h"
+
+namespace Core::Mods::Zstd {
+
+Dicts::~Dicts() {
+    for (const auto& [id, ddict] : by_id) {
+        ZSTD_freeDDict(ddict);
+    }
+}
+
+bool Dicts::Add(std::span<const u8> zsdic) {
+    ZSTD_DDict* const ddict = ZSTD_createDDict(zsdic.data(), zsdic.size());
+    if (ddict == nullptr) {
+        return false;
+    }
+    const u32 id = ZSTD_getDictID_fromDDict(ddict);
+    if (id == 0 || !by_id.emplace(id, ddict).second) {
+        ZSTD_freeDDict(ddict);
+        return false;
+    }
+    return true;
+}
+
+bool Dicts::Decode(std::span<const u8> frame, u64 cap, std::vector<u8>& out,
+                   std::string& error) const {
+    out.clear();
+    if (frame.size() < 4 || frame[0] != 0x28 || frame[1] != 0xB5 || frame[2] != 0x2F ||
+        frame[3] != 0xFD) {
+        error = "not a zstd frame";
+        return false;
+    }
+    const unsigned long long size = ZSTD_getFrameContentSize(frame.data(), frame.size());
+    if (size == ZSTD_CONTENTSIZE_ERROR || size == ZSTD_CONTENTSIZE_UNKNOWN) {
+        error = "zstd frame without a content size";
+        return false;
+    }
+    if (size > cap) {
+        error = "zstd content too large";
+        return false;
+    }
+    const u32 id = ZSTD_getDictID_fromFrame(frame.data(), frame.size());
+    const ZSTD_DDict* ddict = nullptr;
+    if (id != 0) {
+        const auto it = by_id.find(id);
+        if (it == by_id.end()) {
+            error = "unknown zstd dictionary " + std::to_string(id);
+            return false;
+        }
+        ddict = it->second;
+    }
+    const std::unique_ptr<ZSTD_DCtx, decltype(&ZSTD_freeDCtx)> dctx{ZSTD_createDCtx(),
+                                                                    &ZSTD_freeDCtx};
+    if (!dctx) {
+        error = "out of memory";
+        return false;
+    }
+    out.resize(static_cast<size_t>(size));
+    const size_t n =
+        ddict != nullptr
+            ? ZSTD_decompress_usingDDict(dctx.get(), out.data(), out.size(), frame.data(),
+                                         frame.size(), ddict)
+            : ZSTD_decompressDCtx(dctx.get(), out.data(), out.size(), frame.data(), frame.size());
+    if (ZSTD_isError(n) || n != size) {
+        error = ZSTD_isError(n) ? std::string{"zstd: "} + ZSTD_getErrorName(n)
+                                : std::string{"zstd output shorter than its content size"};
+        out.clear();
+        return false;
+    }
+    return true;
+}
+
+} // namespace Core::Mods::Zstd
diff --git a/src/core/mods/mod_zstd.h b/src/core/mods/mod_zstd.h
new file mode 100644
index 0000000..31ae332
--- /dev/null
+++ b/src/core/mods/mod_zstd.h
@@ -0,0 +1,40 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden DSMod fork
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Bounded zstd frame decoder for romfs files, with the dictionaries a game ships (TotK's
+// Pack/ZsDic.pack.zs members) picked by the id the frame header names. Pure format code: no
+// runtime, no logging, no filesystem.
+
+#pragma once
+
+#include <span>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "common/common_types.h"
+
+struct ZSTD_DDict_s;
+
+namespace Core::Mods::Zstd {
+
+class Dicts {
+public:
+    Dicts() = default;
+    Dicts(const Dicts&) = delete;
+    Dicts& operator=(const Dicts&) = delete;
+    ~Dicts();
+
+    /// Adds one zstd-format dictionary; false for id 0 (raw content), an id already held, or
+    /// bytes zstd refuses.
+    bool Add(std::span<const u8> zsdic);
+
+    /// Decodes one frame whose header states its content size (at most `cap`) into `out`; a frame
+    /// naming a dictionary needs that id added. False with `error` set otherwise.
+    bool Decode(std::span<const u8> frame, u64 cap, std::vector<u8>& out, std::string& error) const;
+
+private:
+    std::unordered_map<u32, ZSTD_DDict_s*> by_id;
+};
+
+} // namespace Core::Mods::Zstd
