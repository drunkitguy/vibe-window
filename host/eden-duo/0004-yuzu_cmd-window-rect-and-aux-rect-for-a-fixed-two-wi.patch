+// --window-rect / --aux-rect, read by the window constructors.
+static std::optional<WindowRect> g_window_rect;
+static std::optional<WindowRect> g_aux_rect;
+
+const std::optional<WindowRect>& MainWindowRect() {
+    return g_window_rect;
+}
+
+const std::optional<WindowRect>& AuxWindowRect() {
+    return g_aux_rect;
+}
+
+void PlaceWindow(SDL_Window* window, const std::optional<WindowRect>& rect) {
+    if (window == nullptr || !rect) {
+        return;
+    }
+    if (!SDL_SetWindowPosition(window, rect->x, rect->y) ||
+        !SDL_SetWindowSize(window, rect->w, rect->h)) {
+        LOG_ERROR(Frontend, "Failed to place window at {},{} {}x{}: {}", rect->x, rect->y, rect->w,
+                  rect->h, SDL_GetError());
+    }
+}
