+// SPDX-FileCopyrightText: Copyright 2026 Eden DSMod fork
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <array>
+#include <charconv>
+#include <system_error>
+
+#include "yuzu_cmd/window_rect.h"
+
+namespace DSModHarness {
+
+std::optional<WindowRect> ParseWindowRect(std::string_view text, std::string& error) {
+    std::array<int, 4> values{};
+    std::size_t count = 0;
+    for (std::size_t start = 0;;) {
+        const std::size_t comma = text.find(',', start);
+        const std::string_view field = text.substr(start, comma - start);
+        if (count == values.size()) {
+            error = "expected x,y,w,h, got more than 4 values in '" + std::string(text) + "'";
+            return std::nullopt;
+        }
+        const char* const last = field.data() + field.size();
+        const auto [end, ec] = std::from_chars(field.data(), last, values[count++]);
+        if (ec == std::errc::result_out_of_range) {
+            error = "'" + std::string(field) + "' is out of range";
+            return std::nullopt;
+        }
+        if (field.empty() || ec != std::errc{} || end != last) {
+            error = "'" + std::string(field) + "' is not a number (expected x,y,w,h)";
+            return std::nullopt;
+        }
+        if (comma == std::string_view::npos) {
+            break;
+        }
+        start = comma + 1;
+    }
+    if (count != values.size()) {
+        error = "expected x,y,w,h, got " + std::to_string(count) + " values in '" +
+                std::string(text) + "'";
+        return std::nullopt;
+    }
+    const auto [x, y, w, h] = values;
+    if (x < 0 || y < 0) {
+        error = "x and y must be 0 or more";
+        return std::nullopt;
+    }
+    if (w <= 0 || h <= 0) {
+        error = "w and h must be more than 0";
+        return std::nullopt;
+    }
+    return WindowRect{x, y, w, h};
+}
+
+} // namespace DSModHarness
diff --git a/src/yuzu_cmd/window_rect.h b/src/yuzu_cmd/window_rect.h
new file mode 100644
