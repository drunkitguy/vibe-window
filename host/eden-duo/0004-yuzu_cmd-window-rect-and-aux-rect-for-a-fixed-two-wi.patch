@@ -0,0 +1,31 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden DSMod fork
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+// The `x,y,w,h` value of eden-cli's --window-rect and --aux-rect, kept to std so it builds and
+// tests without SDL or the emulator.
+
+namespace DSModHarness {
+
+/// Largest x+w and y+h a rect may reach.
+constexpr int MaxCoordinate = 32767;
+
+/// A window's desktop position and client size, in SDL window coordinates.
+struct WindowRect {
+    int x;
+    int y;
+    int w;
+    int h;
+};
+
+/// Parses `x,y,w,h`: four decimal ints, x and y >= 0, w >= min_w and h >= min_h (both mins >= 1),
+/// x+w and y+h at most MaxCoordinate. Returns the rect, or nothing with the reason in `error`.
+std::optional<WindowRect> ParseWindowRect(std::string_view text, int min_w, int min_h,
+                                          std::string& error);
+
+} // namespace DSModHarness
