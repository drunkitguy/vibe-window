+    }
+    // Both calls are requests; Wayland, for one, refuses to move a top-level window.
+    if (!SDL_SetWindowPosition(window, rect->x, rect->y)) {
+        LOG_ERROR(Frontend, "Failed to move window to {},{}: {}", rect->x, rect->y, SDL_GetError());
