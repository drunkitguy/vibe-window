--- /dev/null
+++ b/src/yuzu_cmd/window_rect.h
@@ -0,0 +1,27 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden DSMod fork
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+// The `x,y,w,h` value of eden-cli's --window-rect and --aux-rect, kept to std so it builds and
+// tests without SDL or the emulator.
+
+namespace DSModHarness {
+
+/// A window's desktop position and client size, in SDL window coordinates.
+struct WindowRect {
+    int x;
+    int y;
+    int w;
+    int h;
+};
+
+/// Parses `x,y,w,h`: four decimal ints, x and y >= 0, w and h > 0. Returns the rect, or nothing
+/// with the reason in `error`.
+std::optional<WindowRect> ParseWindowRect(std::string_view text, std::string& error);
+
+} // namespace DSModHarness
