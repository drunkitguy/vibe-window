+// SPDX-FileCopyrightText: Copyright 2026 Eden DSMod fork
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// Native module staging, kept to std + POSIX/Win32 so it builds and tests without the emulator.
+
+namespace Core::Mods {
+
+/// The package `module.libraries` key for this host, or empty when native modules are unsupported.
+std::string_view Platform();
+
+/// Copies a verified module into a new private `module-*` directory under `root` (created if
+/// needed) as a read-only `<title>.so`, and returns that directory. Throws on any failure, leaving
+/// nothing staged.
+std::filesystem::path StageModule(const std::vector<std::uint8_t>& bytes, const std::string& title,
+                                  const std::filesystem::path& root);
+
+/// Loads a staged module by its full (wide on Windows) path. Returns the native handle, or null
+/// with the loader's reason in `error`.
+void* OpenStaged(const std::filesystem::path& file, std::string& error);
+
+/// Deletes a staging directory, read-only module included. Best effort, never throws.
+void RemoveStaged(const std::filesystem::path& directory);
+
+/// Deletes `module-*` directories under `root` older than 10 minutes, left by a process that
+/// crashed or was killed. Best effort, never throws.
+void SweepStale(const std::filesystem::path& root);
+
+} // namespace Core::Mods
