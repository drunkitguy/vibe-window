     SaveSdlValues();
 }
 
-SdlConfig::~SdlConfig() {
+// Duo: config_loc stays empty, so nothing (the destructor, WriteToIni) can write the Qt file.
+SdlConfig::SdlConfig(const ConfigType config_type, std::unique_ptr<CSimpleIniA> ini)
+    : Config(config_type) {
+    config = std::move(ini);
     if (global) {
+        // Eden Qt reads its config once; eden-cli has already merged sdl2-config.ini's list here.
+        Settings::values.disabled_addons.clear();
+    }
+    ReadValues();
+    ReadSdlValues();
+    if (global) {
+        ReadPathValues();
+    }
+}
+
+bool SdlConfig::ReadQtConfig(const std::filesystem::path& path, const ConfigType config_type) {
+    const std::string data = Common::FS::ReadStringFromFile(path, Common::FS::FileType::BinaryFile);
+    auto ini = std::make_unique<CSimpleIniA>();
+    ini->SetUnicode(true);
+    ini->SetSpaces(false);
+    // Eden Qt always writes [Controls] (global and per-game), so a file without it is missing,
+    // unreadable or not an Eden Qt config.
+    if (data.empty() || ini->LoadData(data) < 0 ||
+        ini->GetSectionSize(Settings::TranslateCategory(Settings::Category::Controls)) < 0) {
+        return false;
+    }
+    const SdlConfig reader{config_type, std::move(ini)};
+    return true;
+}
+
+SdlConfig::~SdlConfig() {
+    if (global && !config_loc.empty()) {
         SdlConfig::SaveAllValues();
     }
 }
@@ -170,6 +201,27 @@ void SdlConfig::ReadDebugControlValues() {
     }
 }
 
+// Duo: the one Qt path setting the core reads. Eden Qt reads Paths inside the UI group
+// (QtConfig::ReadUIValues calls ReadPathValues), so the array is in [UI] under
+// Paths\external_content_dirs.
+void SdlConfig::ReadPathValues() {
+    BeginGroup(Settings::TranslateCategory(Settings::Category::Ui));
+    BeginGroup(Settings::TranslateCategory(Settings::Category::Paths));
+
+    const int external_dirs_size = BeginArray(std::string("external_content_dirs"));
+    for (int i = 0; i < external_dirs_size; ++i) {
+        SetArrayIndex(i);
+        std::string dir_path = ReadStringSetting(std::string("path"));
+        if (!dir_path.empty()) {
+            Settings::values.external_content_dirs.push_back(dir_path);
+        }
+    }
+    EndArray();
+
+    EndGroup();
+    EndGroup();
+}
+
 void SdlConfig::ReadHidbusValues() {
     const std::string default_param = InputCommon::GenerateAnalogParamFromKeys(
         0, 0, default_ringcon_analogs[0], default_ringcon_analogs[1], 0, 0.05f);
