@@ -199,18 +202,54 @@ extern "C" SDL_AppResult SDL_AppInit(void **appstate, int argc, char **argv) {
 #ifdef _WIN32
     LocalFree(argv_w);
 #endif
-    SdlConfig config{lp.config_path};
+    std::optional<SdlConfig> config{std::in_place, lp.config_path};
     if (!DSModHarness::ResolveSelectedUser(state->dsmod, state->system, lp)) {
         return SDL_APP_FAILURE;
     }
 
-    Core::ApplyLaunchParams(lp);
+    // Duo: run with the settings Eden Qt uses, read-only: qt-config.ini, then the game's
+    // custom/<program id>.ini below. eden-cli's own config is saved first so no Qt value lands in
+    // it; the launch params are applied after both, so a command-line flag always wins.
+    const auto config_dir = Common::FS::GetEdenPath(Common::FS::EdenPath::ConfigDir);
+    bool qt_config = false;
+    if (Common::FS::IsFile(config_dir / "qt-config.ini")) {
+        config.reset();
+        qt_config = SdlConfig::ReadQtConfig(config_dir / "qt-config.ini",
+                                            Config::ConfigType::GlobalConfig);
+    }
 
     if (lp.filepath.empty()) {
         LOG_CRITICAL(Frontend, "Failed to load ROM: No ROM specified");
         return SDL_APP_FAILURE;
     }
 
+    // Duo: the filesystem comes before Initialize so the per-game file is read before anything
+    // (Initialize, the renderer pick) uses the settings.
+    state->system.SetContentProvider(std::make_unique<FileSys::ContentProviderUnion>());
+    state->system.SetFilesystem(std::make_shared<FileSys::RealVfsFilesystem>());
+    state->system.GetFileSystemController().CreateFactories(*state->system.GetFilesystem());
+    if (qt_config) {
+        // As Eden Qt's BootGame: the program id names the file, use_global decides each value.
+        // shortcut: program id 0 (homebrew) gets no per-game file (Qt uses the file name), add it
+        // if a homebrew title needs one.
+        std::string custom;
+        u64 program_id = 0;
+        const auto loader = Loader::GetLoader(
+            state->system, Core::GetGameFileFromPath(state->system.GetFilesystem(), lp.filepath));
+        if (loader != nullptr &&
+            loader->ReadProgramId(program_id) == Loader::ResultStatus::Success && program_id != 0) {
+            custom = fmt::format("custom/{:016X}.ini", program_id);
+            if (!SdlConfig::ReadQtConfig(config_dir / custom, Config::ConfigType::PerGameConfig)) {
+                custom.clear();
+            }
+        }
+        LOG_INFO(Frontend, "Duo config: qt-config.ini{}{}", custom.empty() ? "" : " + ", custom);
+    } else {
+        LOG_INFO(Frontend, "Duo config: eden-cli's own config only (no readable qt-config.ini)");
+    }
+
+    Core::ApplyLaunchParams(lp);
+
     state->system.Initialize();
 
     // Apply the command line arguments
@@ -241,9 +280,6 @@ extern "C" SDL_AppResult SDL_AppInit(void **appstate, int argc, char **argv) {
 #endif
 
     state->system.SetInputSubsystem(&state->input_subsystem);
-    state->system.SetContentProvider(std::make_unique<FileSys::ContentProviderUnion>());
-    state->system.SetFilesystem(std::make_shared<FileSys::RealVfsFilesystem>());
-    state->system.GetFileSystemController().CreateFactories(*state->system.GetFilesystem());
     state->system.GetUserChannel().clear();
 
