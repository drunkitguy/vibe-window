-SdlConfig::~SdlConfig() {
+// Duo: config_loc stays empty, so nothing (the destructor, WriteToIni) can write the Qt file.
+SdlConfig::SdlConfig(const ConfigType config_type, std::unique_ptr<CSimpleIniA> ini)
+    : Config(config_type) {
+    config = std::move(ini);
     if (global) {
+        // Eden Qt reads its config once; eden-cli has already merged sdl2-config.ini's list here.
+        Settings::values.disabled_addons.clear();
+    }
+    ReadValues();
+    ReadSdlValues();
+    if (global) {
+        ReadPathValues();
+    }
+}
+
+bool SdlConfig::ReadQtConfig(const std::filesystem::path& path, const ConfigType config_type) {
+    const std::string data = Common::FS::ReadStringFromFile(path, Common::FS::FileType::BinaryFile);
+    auto ini = std::make_unique<CSimpleIniA>();
+    ini->SetUnicode(true);
+    // Eden Qt always writes [Controls] (global and per-game), so a file without it is missing,
+    // unreadable or not an Eden Qt config.
+    if (ini->LoadData(data) < 0 ||
+        ini->GetSectionSize(Settings::TranslateCategory(Settings::Category::Controls)) < 0) {
+        return false;
+    }
+    const SdlConfig reader{config_type, std::move(ini)};
+    return true;
+}
+
+namespace {
+// Absolute, "..", slashes and symlinks resolved; case-folded on Windows, where names are not
+// case-sensitive. shortcut: ASCII folding only (towlower in the C locale), use
+// CompareStringOrdinal if a non-ASCII case variant of the config dir ever matters.
+std::optional<std::filesystem::path> Resolved(const std::filesystem::path& path) {
+    std::error_code ec;
+    const auto absolute = std::filesystem::absolute(path, ec);
+    if (ec) {
+        return std::nullopt;
+    }
+    auto resolved = std::filesystem::weakly_canonical(absolute, ec);
+    if (ec) {
+        return std::nullopt;
+    }
+#ifdef _WIN32
+    auto folded = resolved.native();
+    for (auto& c : folded) {
+        c = static_cast<wchar_t>(std::towlower(c));
+    }
+    resolved = folded;
+#endif
+    return resolved;
+}
+} // namespace
+
+bool SdlConfig::IsEdenQtFile(const std::string& path) {
+    const auto dir = Resolved(Common::FS::GetEdenPath(Common::FS::EdenPath::ConfigDir));
+    const auto file = Resolved(Common::FS::ToU8String(path));
+    if (!dir || !file) {
+        return true;
+    }
+    const auto relative = file->lexically_relative(*dir);
+    return relative == "qt-config.ini" || (!relative.empty() && *relative.begin() == "custom");
+}
+
+SdlConfig::~SdlConfig() {
+    if (global && !config_loc.empty()) {
         SdlConfig::SaveAllValues();
     }
 }
