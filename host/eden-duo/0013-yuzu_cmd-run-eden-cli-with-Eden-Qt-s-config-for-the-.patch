+bool ApplyEdenQtConfig(Session& session, Core::System& system, Core::LaunchParams& lp,
+                       std::optional<SdlConfig>& config) {
+    // Run with the settings Eden Qt uses, read-only: qt-config.ini, then the game's
+    // custom/<program id>.ini, unless -c names a config. eden-cli's own config is saved first so no
+    // Qt value lands in it; the launch params are applied after both, so a command-line flag always
+    // wins.
+    // shortcut: only eden-cli's own config dir is searched, so a portable eden-cli or Eden Qt
+    // (a user dir next to the exe) does not see the other's files; look in Eden Qt's dir too if a
+    // portable Eden Qt must be supported.
+    const auto config_dir = Common::FS::GetEdenPath(Common::FS::EdenPath::ConfigDir);
+    bool qt_config = false;
+    if (!lp.config_path && Common::FS::IsFile(config_dir / "qt-config.ini")) {
+        config.reset();
+        qt_config = SdlConfig::ReadQtConfig(config_dir / "qt-config.ini",
+                                            Config::ConfigType::GlobalConfig);
+    }
+
+    if (qt_config) {
+        // As Eden Qt's BootGame: the program id names the file, use_global decides each value.
+        // shortcut: program id 0 (homebrew) gets no per-game file (Qt uses the file name), add it
+        // if a homebrew title needs one.
+        std::string custom;
+        u64 program_id = 0;
+        const auto loader = Loader::GetLoader(
+            system, Core::GetGameFileFromPath(system.GetFilesystem(), lp.filepath));
+        if (loader != nullptr &&
+            loader->ReadProgramId(program_id) == Loader::ResultStatus::Success && program_id != 0) {
+            custom = fmt::format("custom/{:016X}.ini", program_id);
+            if (!SdlConfig::ReadQtConfig(config_dir / custom, Config::ConfigType::PerGameConfig)) {
+                custom.clear();
+            }
+        }
+        LOG_INFO(Frontend, "Duo config: qt-config.ini{}{}", custom.empty() ? "" : " + ", custom);
+        // As Eden Qt after a config change: rebuild the factories (built above from eden-cli's
+        // dirs) so the NAND, SD, mod, dump and external content dirs are Eden Qt's.
+        system.GetFileSystemController().CreateFactories(*system.GetFilesystem());
+    } else {
+        LOG_INFO(Frontend, "Duo config: eden-cli's own config only ({})",
+                 lp.config_path ? "-c given" : "no readable qt-config.ini");
+    }
+
+    // As Eden Qt's FixProfiles, re-read profiles.dat now that qt-config.ini has named the NAND and
+    // the user (the manager was built before), resolve -u against it, then reopen the -u user.
+    // Only with the Qt config, so eden-cli's own config keeps its accounts as before.
+    auto& profiles = system.GetProfileManager();
+    if (qt_config) {
+        profiles.ResetUserSaveFile();
+    }
+    if (!ResolveSelectedUser(session, system, lp)) {
+        return false;
+    }
+
+    Core::ApplyLaunchParams(lp);
+    if (qt_config && lp.selected_user) {
+        profiles.ResetUserSaveFile();
+    }
+    return true;
+}
