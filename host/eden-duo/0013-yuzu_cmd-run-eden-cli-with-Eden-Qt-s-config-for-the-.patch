+std::optional<std::filesystem::path> Resolved(const std::filesystem::path& path) {
+    std::error_code ec;
+    const auto absolute = std::filesystem::absolute(path, ec);
+    if (ec) {
+        return std::nullopt;
+    }
+    auto resolved = std::filesystem::weakly_canonical(absolute, ec);
+    if (ec) {
