From 3cc406249c248b3cc16895b72199c8b1029094d4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 2 Nov 2026 07:12:32 +0000
Subject: [PATCH] DSMod: draw an Image widget whose src_bind text is a romfs:
 texture file

An Image widget's src_bind text had to be a sprite_map key or a
module: key; any other text drew nothing. A module that publishes the
game's own picture as a romfs: path (TotK's item icons,
romfs:/UI/Tex/Icon/<id>.bntx.zs) therefore never showed.

Accept a romfs: text when the asset worker decodes it under Locate's
caps: a whole .bntx/.bffnt/.arc/.sarc/.bfres/.sbfres/.bmaptex/.sbmaptex
file, optionally .zs-wrapped. Anything else would reach GetImage's
synchronous path, which reads the whole file on the draw thread with
no size cap and remembers every failure in image_failed, so it still
draws nothing: other romfs: files, and "#member" paths (a member of a
non-Nintendo container falls back to that path).

The path rule of ModRuntime::IsNxAssetSource moves into the pure
NxAssets::IsNxAssetPath (mod_nx_assets.h) so mod_ui.cpp can use it;
IsNxAssetSource keeps its behaviour.

Test: image_fallback.cpp, src_bind with module:, romfs: texture files,
other romfs: files, romfs: "#member" paths and file: texts.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XgyuSR8o8AbzxuWHYqLwsv
---
 src/core/mods/mod_nx_assets.h          |  6 ++++++
 src/core/mods/mod_nx_runtime.cpp       |  9 +++++----
 src/core/mods/mod_ui.cpp               | 12 ++++++++++--
 src/tests/core/mods/image_fallback.cpp | 26 ++++++++++++++++++++++++++
 4 files changed, 47 insertions(+), 6 deletions(-)

diff --git a/src/core/mods/mod_nx_assets.h b/src/core/mods/mod_nx_assets.h
index 14d7dcf9..333f80b4 100644
--- a/src/core/mods/mod_nx_assets.h
+++ b/src/core/mods/mod_nx_assets.h
@@ -190,6 +190,12 @@ void BlendPremul(std::vector<u8>& canvas_premul, u32 canvas_w, u32 canvas_h,
 /// Premultiplied RGBA8 canvas -> straight-alpha ARGB image.
 void PremulToImage(std::span<const u8> premul, u32 width, u32 height, Image& out);
 
+/// The path rule of ModRuntime::IsNxAssetSource, without the source lookup: whether a
+/// directory-source path is decoded by the asset worker under Locate's caps -- a "#member", or a
+/// .bntx/.bffnt/.arc/.sarc/.bfres/.sbfres/.bmaptex/.sbmaptex file (".zs" counts as what it
+/// wraps; ".lzs" never). Implemented in mod_nx_runtime.cpp.
+[[nodiscard]] bool IsNxAssetPath(std::string_view src);
+
 // ---------------------------------------------------------------------------------------------
 // Manifest (implemented in mod_nx_runtime.cpp)
 
diff --git a/src/core/mods/mod_nx_runtime.cpp b/src/core/mods/mod_nx_runtime.cpp
index f86d1f46..4f7fea74 100644
--- a/src/core/mods/mod_nx_runtime.cpp
+++ b/src/core/mods/mod_nx_runtime.cpp
@@ -1748,10 +1748,7 @@ void NxAssetState::RunCompositeStep(const std::string& name) {
 // ---------------------------------------------------------------------------------------------
 // ModRuntime side (tick thread)
 
-bool ModRuntime::IsNxAssetSource(const std::string& src) const {
-    if (!asset_sources->IsDirectorySource(src)) {
-        return false;
-    }
+bool NX::IsNxAssetPath(std::string_view src) {
     const size_t hash = src.find('#');
     std::string_view file = std::string_view{src}.substr(0, hash);
     if (EndsWithNoCase(file, ".zs")) {
@@ -1769,6 +1766,10 @@ bool ModRuntime::IsNxAssetSource(const std::string& src) const {
            EndsWithNoCase(file, ".bmaptex") || EndsWithNoCase(file, ".sbmaptex");
 }
 
+bool ModRuntime::IsNxAssetSource(const std::string& src) const {
+    return asset_sources->IsDirectorySource(src) && NX::IsNxAssetPath(src);
+}
+
 bool ModRuntime::NxFallback(const std::string& src) const {
     std::scoped_lock lock{nx_assets->state_mutex};
     return nx_assets->fallback.contains(src);
diff --git a/src/core/mods/mod_ui.cpp b/src/core/mods/mod_ui.cpp
index 711c42a8..77a3fd1a 100644
--- a/src/core/mods/mod_ui.cpp
+++ b/src/core/mods/mod_ui.cpp
@@ -35,6 +35,7 @@
 #include <fmt/format.h>
 
 #include "common/logging.h"
+#include "core/mods/mod_nx_assets.h"
 #include "core/mods/mod_ui.h"
 #include "core/mods/mod_ui_internal.h"
 #include "core/mods/mod_view_default.h"
@@ -182,8 +183,15 @@ void DrawImage(const WidgetDrawContext& ctx) {
         }
         const auto mapped = manifest.sprite_map.find(text->second);
         if (mapped == manifest.sprite_map.end()) {
-            // Module-owned images use logical keys, validated by that module's decoder.
-            if (!text->second.starts_with("module:")) {
+            // Module-owned images use logical keys, validated by that module's decoder. A romfs:
+            // text is taken only when the asset worker decodes it under Locate's caps: a whole
+            // Nintendo texture/archive file. Not a "#member" (a non-Nintendo container falls back
+            // to the uncapped synchronous read) and not any other file (read whole on the draw
+            // thread, and remembered in image_failed when it does not decode).
+            const std::string& t = text->second;
+            const bool nx_file = t.starts_with("romfs:") && t.find('#') == std::string::npos &&
+                                 NxAssets::IsNxAssetPath(t);
+            if (!t.starts_with("module:") && !nx_file) {
                 return;
             }
             source = &text->second;
diff --git a/src/tests/core/mods/image_fallback.cpp b/src/tests/core/mods/image_fallback.cpp
index 5d8f984f..a3bdca27 100644
--- a/src/tests/core/mods/image_fallback.cpp
+++ b/src/tests/core/mods/image_fallback.cpp
@@ -194,3 +194,29 @@ TEST_CASE("DSMod image fallback: src_fade_ms/src_fade_bind parse, clamp and expa
     REQUIRE(expanded[0].src_fade_bind == "scene_0");
     REQUIRE(expanded[1].src_fade_bind == "scene_1");
 }
+
+TEST_CASE("DSMod image: src_bind accepts module: texts and whole Nintendo romfs: files only",
+          "[dsmod][image_fallback]") {
+    const Widget w = ImageWidget();
+    // The provider answers every key, so only the src_bind rule decides what draws.
+    const ImageProvider images = [](const std::string& key) {
+        return Solid(key.starts_with("module:") ? Blue : Green);
+    };
+    const auto draw = [&](const std::string& text) {
+        ImageFallbackState fallback;
+        StateSnapshot s;
+        s.texts["pic"] = text;
+        return PixelAt(Draw(w, images, s, fallback), 5, 5);
+    };
+    REQUIRE(draw("module:g:a") == Blue);
+    // A game-published texture file goes to the asset worker, under Locate's caps.
+    REQUIRE(draw("romfs:/UI/Tex/Icon/Obj_Arrow.bntx.zs") == Green);
+    REQUIRE(draw("romfs:/UI/Tex/Icon/Obj_Arrow.bntx") == Green);
+    // Anything GetImage would read whole on the draw thread draws nothing: a non-Nintendo
+    // romfs: file, a "#member" (which can fall back to that read), other sources.
+    REQUIRE(draw("romfs:/Pack/Bootup.pack") == Black);
+    REQUIRE(draw("romfs:/UI/Tex/Icon/Obj_Arrow.png") == Black);
+    REQUIRE(draw("romfs:/Pack/X.pack.lzs#a.bntx") == Black);
+    REQUIRE(draw("romfs:/Layout/Common.Product.sarc.zs#timg/a.bntx") == Black);
+    REQUIRE(draw("file:a.png") == Black);
+}
