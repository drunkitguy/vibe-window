<?xml version="1.0" encoding="utf-8"?>
<!-- Settings section header: accent icon and title above a grouped card. Not focusable. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/vw_space_1"
    android:paddingLeft="@dimen/vw_space_1"
    android:paddingTop="28dp"
    android:paddingEnd="@dimen/vw_space_1"
    android:paddingRight="@dimen/vw_space_1"
    android:paddingBottom="@dimen/vw_space_2">

    <FrameLayout
        android:id="@android:id/icon_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/vw_space_3"
        android:layout_marginRight="@dimen/vw_space_3">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:tint="@color/vw_accent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.Vibe.Section" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Vibe.Secondary"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
