<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides the androidx preference "expand_button" layout (same ids) so the
     collapsed group expander reads as a "Show more" row inside the card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/vw_pref_row_background"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/vw_space_4"
    android:paddingLeft="@dimen/vw_space_4"
    android:paddingTop="@dimen/vw_space_3"
    android:paddingEnd="@dimen/vw_space_4"
    android:paddingRight="@dimen/vw_space_4"
    android:paddingBottom="@dimen/vw_space_3">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Vibe.Body"
            android:textColor="@color/vw_accent" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Vibe.Secondary" />
    </LinearLayout>

    <FrameLayout
        android:id="@android:id/icon_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vw_space_4"
        android:layout_marginLeft="@dimen/vw_space_4">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_expand_more"
            android:tint="@color/vw_accent" />
    </FrameLayout>
</LinearLayout>
