<?xml version="1.0" encoding="utf-8"?>
<!-- Chevron of a dropdown settings row: A or a tap opens the full list -->
<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vw_pref_chevron"
    android:layout_width="24dp"
    android:layout_height="24dp"
    android:layout_gravity="center_vertical"
    android:layout_marginStart="@dimen/vw_space_1"
    android:layout_marginLeft="@dimen/vw_space_1"
    android:importantForAccessibility="no"
    android:src="@drawable/ic_chevron_down"
    android:tint="@color/vw_accent_text"
    android:visibility="gone" />
