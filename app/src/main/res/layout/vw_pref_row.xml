<?xml version="1.0" encoding="utf-8"?>
<!-- Settings row used by every preference type. Keeps the androidx ids:
     icon_frame, icon, title, summary and widget_frame. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/vw_pref_row_background"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/vw_space_4"
    android:paddingLeft="@dimen/vw_space_4"
    android:paddingTop="@dimen/vw_space_3"
    android:paddingEnd="@dimen/vw_space_4"
    android:paddingRight="@dimen/vw_space_4"
    android:paddingBottom="@dimen/vw_space_3">

    <FrameLayout
        android:id="@android:id/icon_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/vw_space_4"
        android:layout_marginRight="@dimen/vw_space_4"
        android:visibility="gone">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Vibe.Body" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Vibe.Secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/vw_space_4"
        android:paddingLeft="@dimen/vw_space_4" />
</LinearLayout>
