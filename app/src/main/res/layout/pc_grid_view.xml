<?xml version="1.0" encoding="utf-8"?>
<GridView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragmentView"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:numColumns="auto_fit"
    android:columnWidth="@dimen/vw_host_column_width"
    android:stretchMode="none"
    android:horizontalSpacing="@dimen/vw_host_grid_spacing"
    android:verticalSpacing="@dimen/vw_host_grid_spacing"
    android:padding="@dimen/vw_host_grid_padding"
    android:listSelector="@android:color/transparent"
    android:drawSelectorOnTop="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:nextFocusLeft="@id/settingsButton"
    android:clipToPadding="false"
    android:gravity="center"/>