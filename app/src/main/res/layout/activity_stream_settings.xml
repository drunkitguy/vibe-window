<?xml version="1.0" encoding="utf-8"?>
<!-- Settings screen: the settings header (back, title, "...") above the preference
     list. The fragment container keeps the id stream_settings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stream_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vw_bg"
    android:orientation="vertical"
    tools:context=".preferences.StreamSettings">

    <include layout="@layout/vw_settings_header" />

    <FrameLayout
        android:id="@+id/stream_settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>