<?xml version="1.0" encoding="utf-8"?>
<!-- "All settings" title between the quick settings and the grouped sections -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vw_pref_all_settings"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/vw_space_1"
    android:paddingLeft="@dimen/vw_space_1"
    android:paddingTop="@dimen/vw_space_6"
    android:paddingEnd="@dimen/vw_space_1"
    android:paddingRight="@dimen/vw_space_1">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="@dimen/vw_space_4"
        android:background="@color/vw_separator" />

    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:textAppearance="@style/TextAppearance.Vibe.Title" />

    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Vibe.Secondary"
        android:visibility="gone" />
</LinearLayout>
