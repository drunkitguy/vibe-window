    <color name="vw_glow_start">#8C0051A3</color>
    <color name="vw_scrim">#66000000</color>
    <color name="vw_glyph_dim">#66FFFFFF</color>
    <color name="vw_glyph_muted">#A1FFFFFF</color>
    <color name="vw_switch_track_off">#48484A</color>

