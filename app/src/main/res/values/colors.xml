<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="profileAccent">#FF4081</color>

    <!-- Design tokens shared by the PC list, settings and the app library -->
    <color name="vw_bg">#000000</color>
    <color name="vw_surface">#1C1C1E</color>
    <color name="vw_surface_high">#2C2C2E</color>
    <color name="vw_surface_low">#111113</color>
    <color name="vw_on_surface">#FFFFFF</color>
