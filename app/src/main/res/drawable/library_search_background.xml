<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vw_radius_xl" />
            <solid android:color="@color/vw_surface_high" />
            <stroke
                android:width="2dp"
                android:color="@color/libraryFocus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vw_radius_xl" />
            <solid android:color="@color/vw_surface" />
        </shape>
    </item>
</selector>
