<?xml version="1.0" encoding="utf-8"?>
<!-- Soft accent glow from the bottom right corner of an online host card.
     Same corners as the card so the gradient never leaks outside it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/vw_radius_xl" />
    <gradient
        android:type="radial"
        android:centerX="1.0"
        android:centerY="1.0"
        android:gradientRadius="100%"
        android:startColor="@color/vw_glow_start"
        android:endColor="@android:color/transparent" />
</shape>
